# CineGen Web environment template.
#
# The npm scripts do not load this file automatically. Copy it to
# web/.env.local, review it, then `source web/.env.local` as described in
# web/README.md. Never put real provider credentials in this example file.

# Core server (safe localhost defaults)
HOST=127.0.0.1
PORT=8787
# NODE_ENV=production

# Leave unset to use web/.data. Prefer an absolute path when overriding it.
# CINEGEN_WEB_DATA_ROOT=/absolute/path/to/cinegen-web-data
CINEGEN_WEB_MAX_JSON_BYTES=67108864
CINEGEN_WEB_MAX_UPLOAD_BYTES=4294967296

# Public HTTPS origin that routes /media to this server. This is only
# for a separately secured deployment; do not expose the bare development
# server. It is also needed when cloud inputs are too large for direct staging.
# CINEGEN_PUBLIC_BASE_URL=https://cinegen.example.com

# Optional FFmpeg command/path used by acoustic silence analysis.
# CINEGEN_FFMPEG_PATH=/absolute/path/to/ffmpeg

# Hosted fal.ai, kie.ai, and RunPod keys are entered in the app Settings and
# remain request-scoped. The web server does not read provider keys from env.

# Optional server-side LLM runtimes
CINEGEN_OLLAMA_URL=http://127.0.0.1:11434/
# CINEGEN_CLAUDE_CODE_PATH=/absolute/path/to/claude
# CINEGEN_CODEX_PATH=/absolute/path/to/codex
# CINEGEN_GEMINI_PATH=/absolute/path/to/gemini

# Optional server-side Higgsfield CLI. CINEGEN_HIGGSFIELD_PATH is accepted as
# an alias for CINEGEN_HIGGSFIELD_BIN. Auth commands are deliberately disabled
# by default; enable them only on a trusted, interactive local server.
# CINEGEN_HIGGSFIELD_BIN=/absolute/path/to/higgsfield
# CINEGEN_HIGGSFIELD_PATH=/absolute/path/to/higgsfield
# CINEGEN_HIGGSFIELD_CWD=/absolute/path/to/higgsfield-working-directory
CINEGEN_HIGGSFIELD_ALLOW_AUTH_COMMANDS=0
CINEGEN_HIGGSFIELD_GENERATE_TIMEOUT_MS=480000
CINEGEN_HIGGSFIELD_COMMAND_TIMEOUT_MS=15000

# Optional transcription services. The endpoint overrides Whisper Cloud;
# the worker enables local Faster Whisper / WhisperX engines.
# CINEGEN_TRANSCRIPTION_ENDPOINT=https://transcription.example.com/transcribe
# CINEGEN_TRANSCRIPTION_WORKER_URL=https://worker.example.com/transcribe
# CINEGEN_TRANSCRIPTION_WORKER_API_KEY=replace-with-worker-key

# Optional LTX local runtime
# CINEGEN_LTX_REPO=/absolute/path/to/ltx-runtime
# CINEGEN_LTX_PYTHON=/absolute/path/to/ltx-runtime/.venv/bin/python
# CINEGEN_LTX_SCRIPT=/absolute/path/to/ltx-runtime/infer.py

# Optional Qwen Edit local runtime
# CINEGEN_QWEN_EDIT_REPO=/absolute/path/to/qwen-edit-runtime
# CINEGEN_QWEN_EDIT_PYTHON=/absolute/path/to/qwen-edit-runtime/.venv/bin/python
# CINEGEN_QWEN_EDIT_SCRIPT=/absolute/path/to/qwen-edit-runtime/infer.py

# Optional Layer Decompose local runtime
# CINEGEN_LAYER_DECOMPOSE_REPO=/absolute/path/to/layer-decompose-runtime
# CINEGEN_LAYER_DECOMPOSE_PYTHON=/absolute/path/to/layer-decompose-runtime/.venv/bin/python
# CINEGEN_LAYER_DECOMPOSE_SCRIPT=/absolute/path/to/layer-decompose-runtime/infer.py

# Optional WhisperX local-model runtime
# CINEGEN_WHISPERX_REPO=/absolute/path/to/whisperx-runtime
# CINEGEN_WHISPERX_PYTHON=/absolute/path/to/whisperx-runtime/.venv/bin/python
# CINEGEN_WHISPERX_SCRIPT=/absolute/path/to/whisperx-runtime/infer.py

# Optional SAM 3 remote service (public HTTPS only)
# CINEGEN_SAM3_BASE_URL=https://sam3.example.com
# CINEGEN_SAM3_API_KEY=replace-with-sam3-key

# Or run SAM 3 as a managed local Python service
# CINEGEN_SAM3_PYTHON=/absolute/path/to/sam3/.venv/bin/python
# CINEGEN_SAM3_SCRIPT=/absolute/path/to/sam3/server.py
# CINEGEN_SAM3_CWD=/absolute/path/to/sam3
