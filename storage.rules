rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function teamMember(teamId) {
      return request.auth != null
        && teamId is string
        && firestore.exists(/databases/(default)/documents/teams/$(teamId))
        && firestore.get(/databases/(default)/documents/teams/$(teamId)).data.members.get(request.auth.uid, '') in ['owner', 'editor'];
    }

    // Project access points to a team so every teammate can use every project media file.
    function projectMember(projectId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/projectAccess/$(projectId))
        && (
          firestore.get(/databases/(default)/documents/projectAccess/$(projectId)).data.members.get(request.auth.uid, '') in ['owner', 'editor']
          || teamMember(firestore.get(/databases/(default)/documents/projectAccess/$(projectId)).data.get('teamId', ''))
        );
    }

    match /users/{userId}/projects/{projectId}/{allPaths=**} {
      allow read, write: if request.auth != null
        && (request.auth.uid == userId || projectMember(projectId));
    }
  }
}
