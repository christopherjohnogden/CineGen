rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function teamMember(teamId) {
      return signedIn()
        && teamId is string
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.members.get(request.auth.uid, '') in ['owner', 'editor'];
    }

    function teamOwner(teamId) {
      return signedIn()
        && teamId is string
        && exists(/databases/$(database)/documents/teams/$(teamId))
        && get(/databases/$(database)/documents/teams/$(teamId)).data.members.get(request.auth.uid, '') == 'owner';
    }

    function projectMember(projectId) {
      return signedIn()
        && exists(/databases/$(database)/documents/projectAccess/$(projectId))
        && (
          get(/databases/$(database)/documents/projectAccess/$(projectId)).data.members.get(request.auth.uid, '') in ['owner', 'editor']
          || teamMember(get(/databases/$(database)/documents/projectAccess/$(projectId)).data.get('teamId', ''))
        );
    }

    match /users/{userId} {
      allow read, create, update, delete: if signedIn() && request.auth.uid == userId;

      match /projects/{projectId} {
        allow read, create, update, delete: if signedIn()
          && (request.auth.uid == userId || projectMember(projectId));

        match /{document=**} {
          allow read, create, update, delete: if signedIn()
            && (request.auth.uid == userId || projectMember(projectId));
        }
      }

      match /{document=**} {
        allow read, create, update, delete: if signedIn() && request.auth.uid == userId;
      }
    }

    match /projectAccess/{projectId} {
      allow get: if signedIn()
        && (teamMember(resource.data.get('teamId', ''))
          || request.auth.uid in resource.data.memberIds
          || exists(/databases/$(database)/documents/users/$(request.auth.uid)/projects/$(projectId)));
      allow list: if signedIn()
        && (teamMember(resource.data.get('teamId', ''))
          || request.auth.uid in resource.data.memberIds);
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && (teamOwner(request.resource.data.get('teamId', ''))
          || request.resource.data.members.get(request.auth.uid, '') == 'owner')
        && exists(/databases/$(database)/documents/users/$(request.auth.uid)/projects/$(projectId));
      allow update, delete: if signedIn()
        && (teamOwner(resource.data.get('teamId', ''))
          || resource.data.members.get(request.auth.uid, '') == 'owner');
    }

    match /teams/{teamId} {
      // A user's personal team has a deterministic ID. Permit that user to
      // read the path before it exists so the client can safely create it in
      // a transaction. Existing shared teams remain member-only.
      allow get: if signedIn()
        && (teamId == 'team_' + request.auth.uid
          || request.auth.uid in resource.data.memberIds);
      allow list: if signedIn()
        && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.members.get(request.auth.uid, '') == 'owner'
        && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn()
        && resource.data.members.get(request.auth.uid, '') == 'owner'
        && request.resource.data.ownerId == resource.data.ownerId;
      allow delete: if signedIn()
        && resource.data.members.get(request.auth.uid, '') == 'owner';
    }

    match /emailIndex/{emailHash} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.auth.token.email != null
        && request.resource.data.email == request.auth.token.email;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == resource.data.email;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Owner-funded provider credentials, limits, and usage are server-managed.
    // Clients can never read an encrypted credential or alter the audit trail.
    match /projectFundingSecrets/{projectId} {
      allow read, write: if false;
    }

    match /projectFundingUsage/{usageId} {
      allow read, write: if false;
    }

    match /projectFundingJobs/{jobId} {
      allow read: if projectMember(resource.data.projectId);
      allow create, update, delete: if false;
    }
  }
}
